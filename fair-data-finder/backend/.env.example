# Azure AD / Microsoft SSO (required for user login)
AZURE_APP_CLIENT_SECRET=your-azure-app-client-secret
AZURE_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application
APP_SECRET_KEY=generate-a-random-secret-key  # e.g. openssl rand -hex 32
ENVIRONMENT=local
STAC_FASTAPI_TITLE=Fair Data Finder STAC API
STAC_FASTAPI_DESCRIPTION=A STAC API for FAIR geospatial datasets
STAC_FASTAPI_VERSION=3.0.0a2
APP_HOST=0.0.0.0
APP_PORT=8000
RELOAD=true
WEB_CONCURRENCY=10

# Auth & RBAC
ADMIN_USERS=admin@example.com

# ---------------------------------------------------------------------------
# Database — used by Alembic/SQLModel (DB_CONNECTION_URL) and by
# stac-fastapi-pgstac + pypgstac migrate (PG*).
#
# Local docker compose (migrate/backend containers → postgres service):
#   PGHOST=postgres
#   DB_CONNECTION_URL=...@postgres:5432/...
#
# Backend on the host against Compose-mapped Postgres (port 5433):
#   PGHOST=localhost
#   PGPORT=5433
#   DB_CONNECTION_URL=...@localhost:5433/...
#
# Production (native DB on a separate host):
#   PGHOST=<db-hostname>
#   DB_CONNECTION_URL=...@<db-hostname>:5432/...
# ---------------------------------------------------------------------------
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres
DB_CONNECTION_URL=postgresql+psycopg://postgres:postgres@postgres:5432/postgres

# ---------------------------------------------------------------------------
# APP_DOMAIN  — hostname only (no scheme, no /api), used to build the OAuth
#               redirect URI: https://{APP_DOMAIN}/api/auth/callback
#               Must be registered in Azure App Registration → Authentication.
#
# FRONTEND_URL — full URL the backend redirects to after a successful login.
#
# Local dev (docker compose up, or npm run dev + docker compose up backend proxy):
#   APP_DOMAIN=localhost
#   FRONTEND_URL=http://localhost:3000/
#   Azure redirect URI to register: https://localhost/api/auth/callback
#   Note: the Caddy proxy (proxy/ service) provides https://localhost on port 443.
#         Accept the self-signed cert in your browser the first time.
#
# Production (e.g. fair-data-finder.deltares.nl):
#   APP_DOMAIN=fair-data-finder.deltares.nl
#   FRONTEND_URL=https://fair-data-finder.deltares.nl
#   Azure redirect URI to register: https://fair-data-finder.deltares.nl/api/auth/callback
# ---------------------------------------------------------------------------
APP_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000/

# ---------------------------------------------------------------------------
# COOKIE_SECURE — adds the Secure flag to the session cookie, so the browser
#                 only sends it over HTTPS. Defaults to true when unset.
#
# Set to false only for local dev browsed over plain HTTP on
# http://localhost:3000: login sets the cookie via https://localhost (Caddy),
# and with Secure enabled the browser would refuse to send it back to the
# HTTP origin. Browsing local dev on https://localhost instead lets you keep
# this at true.
#
# Always true in production.
# ---------------------------------------------------------------------------
COOKIE_SECURE=false
