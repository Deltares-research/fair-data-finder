# Frontend environment variables.
#
# Every variable the app reads is resolved at container start, not at image
# build time, so one image tag can be promoted from dev to production.
#
# NUXT_PUBLIC_* values are serialised into the HTML payload and are readable in
# browser devtools. Never put a secret in one.

# Runtime, server-only. Where server-side rendering reaches the backend.
# Not exposed to the browser. In dev this doubles as the Nitro dev-proxy target
# that serves the browser's relative /api calls.
#   Docker Compose:        http://backend:8000/api
#   Native `npm run dev`:  http://localhost:8000/api
NUXT_INTERNAL_API_BASE_URL=http://localhost:8000/api

# Runtime, public. Mapbox public access token (pk.*); the map will not load
# without it. Public by design — restrict it by URL in the Mapbox dashboard
# rather than trying to hide it.
NUXT_PUBLIC_MAPBOX_TOKEN=

# Runtime, public. Shows the About tab.
NUXT_PUBLIC_ABOUT_TAB_ENABLED=true

# Runtime, public. Opt-out flags: unset keeps the full Fair Data Finder
# behaviour. Set to false for a deployment without login (STARS4Water), which
# also hides the register and admin tabs.
#NUXT_PUBLIC_AUTH_ENABLED=false
#NUXT_PUBLIC_REGISTER_TAB_ENABLED=false
#NUXT_PUBLIC_ADMIN_TABS_ENABLED=false

# Tooling only — not read by the application. Backend used by
# `npm run schema:update` to refresh the committed openapi/api.json.
# Defaults to http://localhost:8000.
#API_URL=http://localhost:8000
